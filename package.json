{
  "name": "xiv-gear-lab",
  "version": "0.12.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @xiv-gear-lab/web",
    "dev:desktop": "concurrently -k -n web,desktop \"npm run dev:web\" \"npm run dev -w @xiv-gear-lab/desktop\"",
    "package:windows": "npm run build && npm run package:windows -w @xiv-gear-lab/desktop",
    "sync:data": "node scripts/sync-whm-data.mjs",
    "sync:whm": "npm run sync:data",
    "catalogue:update": "tsx scripts/catalogue-update-assistant.mjs",
    "data:check": "tsx scripts/catalogue-update-assistant.mjs --mode patch --report artifacts/data-availability-check.json",
    "data:update:heavensward": "node scripts/run-owner-data-update.mjs --expansion hw",
    "data:update:arr": "node scripts/run-owner-data-update.mjs --expansion arr",
    "data:update:patch": "node scripts/run-owner-data-update.mjs",
    "build:data-release": "tsx scripts/build-data-release.ts",
    "stage:data-production": "node scripts/stage-production-data-release.mjs",
    "verify:data-production": "tsx scripts/verify-production-data-channel.ts",
    "verify:data-hosted": "tsx scripts/verify-production-data-channel.ts --hosted",
    "package:windows:production": "node scripts/package-production.mjs",
    "drill:installed-update": "node scripts/run-installed-update-drill.mjs",
    "drill:hosted-update": "node scripts/run-hosted-update-drill.mjs",
    "smoke:historical-ui": "electron scripts/stormblood-ui-smoke.mjs",
    "smoke:rotation-ui": "electron scripts/rotation-ui-smoke.mjs",
    "smoke:m14a-ui": "electron scripts/m14a-ui-smoke.mjs",
    "validate:m13b": "tsx scripts/validate-m13b-pilots.ts",
    "validate:m13b:deep": "tsx scripts/validate-m13b-pilots.ts --deep",
    "validate:m13c:healers": "tsx scripts/validate-m13c-healers.ts",
    "validate:m13c:healers:deep": "tsx scripts/validate-m13c-healers.ts --deep",
    "validate:m13c:tanks": "tsx scripts/validate-m13c-tanks.ts",
    "validate:m13c:tanks:deep": "tsx scripts/validate-m13c-tanks.ts --deep",
    "validate:m13c:melee": "tsx scripts/validate-m13c-melee.ts",
    "validate:m13c:melee:deep": "tsx scripts/validate-m13c-melee.ts --deep",
    "validate:m13c:ranged": "tsx scripts/validate-m13c-ranged.ts",
    "validate:m13c:ranged:deep": "tsx scripts/validate-m13c-ranged.ts --deep",
    "validate:m13c:casters": "tsx scripts/validate-m13c-casters.ts",
    "validate:m13c:casters:deep": "tsx scripts/validate-m13c-casters.ts --deep",
    "validate:m13e": "tsx scripts/validate-m13e-acceptance.ts",
    "validate:m13e:deep": "tsx scripts/validate-m13e-acceptance.ts --deep",
    "validate:m13e:samurai": "tsx scripts/validate-m13e-samurai-cadence.ts",
    "validate:m13e:healers": "tsx scripts/validate-m13e-healer-sustainability.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.3",
    "fake-indexeddb": "^6.2.4",
    "sharp": "0.35.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
